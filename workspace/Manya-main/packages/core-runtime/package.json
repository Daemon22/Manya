{
  "name": "@manya/core-runtime",
  "version": "1.0.0",
  "type": "module",
  "description": "Manya core runtime — the composition root that boots one connected Manya: unify mesh + event bus, nervous-system EventFabric, knowledge registry, HAEL Foundation domain, WebSocket transport with presence, and optional Manya-OS bridge.",
